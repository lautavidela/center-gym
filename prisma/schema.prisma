generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Gym {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now())
  users       User[]
  clients     Client[]
  plans       Plan[]
  memberships Membership[]
  payments    Payment[]
  attendances Attendance[]
  routineExercises RoutineExercise[]
  emailCodes  EmailCode[]
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  gymId        Int?
  gym          Gym?      @relation(fields: [gymId], references: [id])
  isSuperAdmin Boolean   @default(false)
  createdAt    DateTime @default(now())
}

model Plan {
  id              Int          @id @default(autoincrement())
  gymId           Int
  gym             Gym          @relation(fields: [gymId], references: [id])
  name            String
  classesPerMonth Int
  price           Float        @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  memberships     Membership[]
  payments        Payment[]

  @@unique([gymId, name])
}

model Client {
  id          Int           @id @default(autoincrement())
  gymId       Int
  gym         Gym           @relation(fields: [gymId], references: [id])
  dni         String?
  name        String
  phone       String?
  email       String?
  pinHash     String?
  notes       String?
  isSuspended Boolean       @default(false)
  createdAt   DateTime      @default(now())
  memberships Membership[]
  payments    Payment[]
  attendances Attendance[]
  routineExercises RoutineExercise[]
  emailCodes  EmailCode[]

  @@unique([gymId, dni])
}

model EmailCode {
  id         Int      @id @default(autoincrement())
  gymId      Int
  gym        Gym      @relation(fields: [gymId], references: [id])
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purpose    String
  codeHash   String
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([clientId, purpose])
}

model Exercise {
  id           String            @id
  name         String
  muscle       String?
  bodyPart     String?
  equipment    String?
  gifUrl       String
  instructions String?
  routines     RoutineExercise[]
}

model RoutineExercise {
  id         Int      @id @default(autoincrement())
  gymId      Int
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  clientId   Int
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  day        Int      @default(0)
  sets       Int      @default(3)
  reps       String   @default("12")
  rest       String   @default("60")
  notes      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([clientId, day, exerciseId])
}

model Membership {
  id        Int      @id @default(autoincrement())
  clientId  Int
  gymId     Int
  gym       Gym      @relation(fields: [gymId], references: [id])
  planId    Int?
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan      Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments  Payment[]
}

model Payment {
  id           Int        @id @default(autoincrement())
  clientId     Int
  planId       Int
  gymId        Int
  gym          Gym        @relation(fields: [gymId], references: [id])
  membershipId Int?
  amount       Float
  method       String     @default("efectivo")
  paidAt       DateTime   @default(now())
  notes        String?
  createdAt    DateTime   @default(now())
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan         Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
}

model Attendance {
  id       Int      @id @default(autoincrement())
  clientId Int
  gymId    Int
  gym      Gym      @relation(fields: [gymId], references: [id])
  day      String
  dateTime DateTime @default(now())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, day])
}